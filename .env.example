# Hearth configuration. Copy to .env. Never commit .env.

# --- process ---
HEARTH_ENV=production
HEARTH_LOG_LEVEL=info
HEARTH_ROLES=all
HEARTH_PUBLIC_URL=http://127.0.0.1:8787
HEARTH_GATEWAY_HOST=0.0.0.0
HEARTH_GATEWAY_PORT=8787
# Host publish for the gateway. Behind BaoTa/nginx keep 127.0.0.1.
# HEARTH_HTTP_BIND=127.0.0.1
# HEARTH_HTTP_PORT=8787
# caddy | external | none. external means an existing reverse proxy and no Caddy.
# HEARTH_PROXY=external
HEARTH_DATA_DIR=./data
HEARTH_ADMIN_USER=owner
HEARTH_ADMIN_PASSWORD=change-me
HEARTH_INTERNAL_TOKEN=change-me-internal
# Invite lifetime in hours. Default 168 (7 days).
# HEARTH_INVITE_TTL_HOURS=168
HEARTH_COOKIE_SECURE=0
DATABASE_URL=postgres://hearth:hearth@127.0.0.1:5432/hearth

# --- LLM (DeepSeek Messages API, same key dsh uses) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
# HEARTH_LLM_MODE=live
# LLM_PROVIDER=openai-compatible
# HEARTH_SPINE=native

# --- email ---
EMAIL_ENABLED=0
EMAIL_REQUIRE_APPROVAL=1
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM=
# Gmail XOAUTH2 (optional, instead of IMAP_PASSWORD)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# personal | enterprise. Enterprise plus PSTN_ENABLED / SMS_ENABLED turns those products on.
HEARTH_PLAN=personal
PSTN_ENABLED=0
SMS_ENABLED=0
# Local Aliyun trial without an enterprise plan:
# HEARTH_DEV_PSTN=1
# HEARTH_DEV_SMS=1
# In-app WebRTC. stun.l.google.com is blocked in mainland China; leave this empty
# and set TURN or a reachable STUN. An empty value gathers host candidates only.
HEARTH_STUN_URL=
# JSON list of {urls, username, credential}. TURN can also be set with the three vars below.
# HEARTH_ICE_SERVERS=[{"urls":"stun:203.0.113.10:3478"}]
# HEARTH_TURN_URL=turn:203.0.113.10:3478?transport=udp
# HEARTH_TURN_USERNAME=
# HEARTH_TURN_PASSWORD=
# Public address written into ICE host candidates. Must match the security group, 1:1 with the UDP range.
# HEARTH_ICE_PUBLIC_IP=
HEARTH_ICE_PORT_MIN=50000
HEARTH_ICE_PORT_MAX=50199
# Optional coturn profile: TURN_ENABLED=1 and docker compose --profile turn.
# TURN_ENABLED=0
# TURN_PORT=3478
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200
# Image build mirrors. install.sh --mirror cn fills these.
# HEARTH_APT_MIRROR=https://mirrors.aliyun.com
# HEARTH_IMAGE_PREFIX=mirror.ccs.tencentyun.com/
# DOCKER_CLI_BASE=https://mirrors.aliyun.com/docker-ce/linux/static/stable
# NPM_REGISTRY=https://registry.npmmirror.com
SIP_NUMBER_POOL=
SIP_SHARED_MAIN=
SIP_TRUNK_CONCURRENCY=2
SIP_USER_CONCURRENCY=1
SIP_USER_RATE_PER_HOUR=20
# none | memory | aliyun | twilio | android-gateway
SMS_PROVIDER=none
SMS_REQUIRE_APPROVAL=1
# JSON map of friendly name -> Aliyun template code
SMS_TEMPLATE_MAP={"notify":"SMS_000000"}
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# Optional unguessable token appended to the console callback URL. Official HTTP push is unsigned.
ALIYUN_SMS_CALLBACK_TOKEN=
ALIYUN_SMS_MNS=0
ALIYUN_SMS_UP_QUEUE=
ALIYUN_SMS_REPORT_QUEUE=
# Fixed communications MNS host from the official Dybase demo. Override if Aliyun changes it.
ALIYUN_SMS_MNS_ENDPOINT=https://1943695596114318.mns.cn-hangzhou.aliyuncs.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ANDROID_SMS_GATEWAY_URL=
ANDROID_SMS_GATEWAY_TOKEN=

# --- SIP ---
# generic | aliyun-trial | aliyun-prod
SIP_ENABLED=0
SIP_PROFILE=aliyun-trial
SIP_TRUNK_MODE=
SIP_REGION=shanghai
SIP_PROXY_HOST=
SIP_PROXY_PORT=5060
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_ID=
SIP_CALLED_PREFIX=
SIP_PUBLIC_IP=
SIP_SIGNAL_PORT=5060
SIP_RTP_PORT_MIN=10000
SIP_RTP_PORT_MAX=10199
SIP_CODECS=PCMA,PCMU
SIP_AUTO_ANSWER=1
SIP_REQUIRE_APPROVAL=1

# --- sandbox ---
HEARTH_SANDBOX=local
HEARTH_NODE_ID=local
# Dev uses a host folder. Production compose bind-mounts an absolute host path at
# the same path inside the sandbox manager (/var/lib/hearth/workspaces by default),
# because the host Docker daemon resolves -v sources on the host.
HEARTH_WORKSPACE_ROOT=./data/workspaces
# Mainland China image builds: npm registry. install.sh --mirror cn sets this.
# NPM_REGISTRY=https://registry.npmmirror.com
# Optional Docker Hub accelerator. Aliyun issues a per-account URL in the container
# registry console (镜像工具 → 镜像加速器). install.sh writes daemon.json only when set.
# HEARTH_DOCKER_REGISTRY_MIRROR=
