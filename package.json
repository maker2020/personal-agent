{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth — a personal agent platform built on DeepSeek Harness (dsh)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages test scripts",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/packages/gateway/src/main.js",
    "start:agent": "node dist/packages/agent/src/main.js",
    "start:sentinel": "node dist/packages/sentinel/src/main.js",
    "smoke": "node dist/scripts/smoke.js",
    "smoke-live": "node dist/scripts/smoke-live.js",
    "verify:dsh": "node dist/scripts/verify-dsh.js"
  },
  "dependencies": {
    "@alicloud/dybaseapi20170525": "1.0.0",
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/openapi-core": "1.0.8",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@langchain/core": "1.3.1",
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "imapflow": "2.9.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "werift": "0.25.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "overrides": {
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
